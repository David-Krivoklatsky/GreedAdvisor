// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(255)
  password          String?   @db.VarChar(255)
  name              String?   @db.VarChar(255)
  firstName         String?   @db.VarChar(100)
  lastName          String?   @db.VarChar(100)
  provider          String    @default("email") @db.VarChar(20) // 'email' | 'google' | 'github'
  providerAccountId String?   @db.VarChar(255)
  profilePicture    String?   @db.Text
  riskProfile       String    @default("balanced") @db.VarChar(20) // 'conservative' | 'balanced' | 'aggressive'
  isActive          Boolean   @default(true)
  lastLogin         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  sessions          UserSession[]
  apiKeyLogs        ApiKeyLog[]
  aiApiKeys         AiApiKey[]
  t212ApiKeys       T212ApiKey[]
  marketDataKeys    MarketDataKey[]
  watchlistItems    WatchlistItem[]
  automationConfigs AutomationConfig[]
  tradeSignals      TradeSignal[]
  tradeRecords      TradeRecord[]
  notifications     Notification[]
  automationRunLogs AutomationRunLog[]
  dailyStats        DailyStat[]

  @@unique([provider, providerAccountId])
  @@index([email])
  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    Int
  token     String   @unique @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model ApiKeyLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  keyType   String   @db.VarChar(50) // 'openai' or 't212'
  action    String   @db.VarChar(50) // 'created', 'updated', 'deleted', 'accessed'
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyType])
  @@index([action])
  @@index([createdAt])
  @@map("api_key_logs")
}

model AiApiKey {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String    @db.VarChar(255)
  provider  String    @db.VarChar(100) // 'openai', 'anthropic', 'google', etc.
  apiKey    String    @db.Text
  isActive  Boolean   @default(true)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@map("ai_api_keys")
}

model T212ApiKey {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String    @db.VarChar(255)
  apiKey      String    @db.Text
  apiSecret   String    @db.Text
  environment String    @default("demo") @db.VarChar(20) // 'demo' or 'live'
  accessType  String    @db.VarChar(50) // 'read-only', 'full-access' (Trading212 only)
  provider    String    @default("trading212") @db.VarChar(20) // 'trading212' or 'alpaca'
  isActive    Boolean   @default(true)
  lastUsed    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([environment])
  @@index([accessType])
  @@index([provider])
  @@index([isActive])
  @@map("t212_api_keys")
}

model MarketDataKey {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String    @db.VarChar(255)
  provider  String    @db.VarChar(100) // 'twelvedata', etc.
  apiKey    String    @db.Text
  isActive  Boolean   @default(true)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@map("market_data_api_keys")
}

model WatchlistItem {
  id             Int      @id @default(autoincrement())
  userId         Int
  ticker         String   @db.VarChar(50) // plain symbol, e.g. 'AAPL', 'BTC'
  name           String?  @db.VarChar(255)
  instrumentType String   @default("STOCK") @db.VarChar(30) // 'STOCK' | 'ETF' | 'CRYPTO' | 'FOREX'
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId])
  @@index([ticker])
  @@map("watchlist_items")
}

// Per-user autonomous trading engine configuration.
model AutomationConfig {
  id                   Int       @id @default(autoincrement())
  userId               Int
  title                String    @db.VarChar(255)
enabled             Boolean  @default(false)
  mode                String   @default("advisory") @db.VarChar(20) // 'advisory' | 'paper' | 'live'
  execution           String   @default("auto") @db.VarChar(20) // 'auto' | 'approval'
  allowLive           Boolean  @default(false)
  market              String   @default("us") @db.VarChar(10) // 'us' | 'eu' | 'crypto'
  strategy            String   @default("momentum") @db.VarChar(30) // 'momentum' | 'trend' | 'mean_reversion' | 'breakout' | 'scalp' | 'swing'
  scanIntervalMinutes Int      @default(5)
  universe            String   @default("watchlist") @db.VarChar(30) // 'watchlist' | 'watchlist+movers'
  symbols             String[]
  maxCandidates       Int      @default(5)
  maxPositions        Int      @default(10)
  maxRiskPerTradePct  Float    @default(0.02)
  maxDailySpendPct    Float    @default(0.2)
  dailyLossLimitPct   Float    @default(0.03)
  stopOnLoss          Boolean  @default(true)
  maxDailyTrades      Int      @default(5)
  confidenceThreshold  Int       @default(70)
  respectPdt           Boolean   @default(true)
  flattenAtClose       Boolean   @default(false)
  manageStops          Boolean   @default(false)
  cooldownMinutes      Int       @default(30)
  orderType            String    @default("MARKET") @db.VarChar(20) // 'MARKET' | 'LIMIT'
  slippageTolerancePct Float     @default(0.005)
  extendedHours        Boolean   @default(false)
  tradingKeyId         Int?
  aiKeyId              Int?
  marketDataKeyId      Int?
  model                String?   @db.VarChar(100)
  telegramChatId       String?   @db.VarChar(255)
  nextRunAt            DateTime  @default(now())
  lastRunAt            DateTime?
  lastRunStatus        String?   @db.VarChar(50)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  // Relations
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs         AutomationRunLog[]
  tradeSignals TradeSignal[]
  tradeRecords TradeRecord[]
  dailyStats   DailyStat[]

  @@index([userId])
  @@index([enabled])
  @@index([mode])
  @@map("automation_configs")
}

// Persisted AI trade signals (reports) so advice is auditable and the engine
// can act on them.
model TradeSignal {
  id                 Int       @id @default(autoincrement())
  userId             Int
  automationConfigId Int?
  symbol             String    @db.VarChar(50)
  action             String    @db.VarChar(20) // BUY | SELL | HOLD | ADD | TRIM
  recommendation     String    @db.VarChar(20) // BUY | SELL | HOLD
  confidence         Int       @default(0)
  summary            String    @db.Text
  analysis           Json?
  entryPrice         Float?
  stopLoss           Float?
  takeProfit         Float?
  positionSize       Float?
  riskAmount         Float?
  riskPerUnit        Float?
  report             Json
  marketSnapshot     Json?
  news               Json?
  status             String    @default("open") @db.VarChar(20) // open | acted | ignored | expired
  source             String    @default("scheduled") @db.VarChar(20) // manual | scheduled | engine
  provider           String?   @db.VarChar(50)
  generatedAt        DateTime  @default(now())
  actedAt            DateTime?

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  automationConfig AutomationConfig? @relation(fields: [automationConfigId], references: [id], onDelete: SetNull)
  tradeRecord      TradeRecord?

  @@index([userId])
  @@index([automationConfigId])
  @@index([status])
  @@index([symbol])
  @@map("trade_signals")
}

// Order book: every order placed through the app (manual or autonomous).
model TradeRecord {
  id                 Int       @id @default(autoincrement())
  userId             Int
  automationConfigId Int?
  signalId           Int?      @unique
  tradingKeyId       Int
  symbol             String    @db.VarChar(50)
  side               String    @db.VarChar(10) // BUY | SELL
  quantity           Float
  orderType          String    @default("MARKET") @db.VarChar(20)
  orderId            String    @db.VarChar(100)
  clientOrderId      String?   @db.VarChar(128)
  entryPrice         Float?
  stopLoss           Float?
  takeProfit         Float?
  stopOrderId        String?   @db.VarChar(100)
  takeProfitOrderId  String?   @db.VarChar(100)
  status             String    @db.VarChar(30) // submitted | partial | filled | cancelled | rejected | expired
  reason             String?   @db.VarChar(255)
  filledQuantity     Float     @default(0)
  filledAvgPrice     Float?
  exitPrice          Float?
  realizedPnl        Float?
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  automationConfig AutomationConfig? @relation(fields: [automationConfigId], references: [id], onDelete: SetNull)
  signal           TradeSignal?      @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([automationConfigId])
  @@index([status])
  @@index([symbol])
  @@map("trade_records")
}

// In-app notifications (the engine and API write here; UI reads/marks-read).
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @db.VarChar(30) // signal | order | sl_tp | daily_loss | error | system
  title     String   @db.VarChar(255)
  body      String?  @db.Text
  payload   Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// Audit row for every scheduled engine run.
model AutomationRunLog {
  id               Int      @id @default(autoincrement())
  userId           Int
  automationConfigId Int?
  status           String   @db.VarChar(30) // running | success | partial | failed | skipped
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
  error            String?  @db.Text
  details          Json?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  automationConfig AutomationConfig? @relation(fields: [automationConfigId], references: [id], onDelete: SetNull)
  steps AutomationRunStep[]

  @@index([userId])
  @@index([automationConfigId])
  @@map("automation_run_logs")
}

// One step of an automation cycle (e.g. market-hours gate, pre-screen,
// AI report, guardrails, order placement) with its status and result.
model AutomationRunStep {
  id         Int      @id @default(autoincrement())
  runLogId   Int
  step       String   @db.VarChar(60) // machine key, e.g. 'analyze:AAPL'
  label      String   @db.VarChar(200)
  status     String   @db.VarChar(20) // running | ok | warn | skipped | failed
  detail     Json?
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  // Relations
  runLog AutomationRunLog @relation(fields: [runLogId], references: [id], onDelete: Cascade)

  @@index([runLogId])
  @@index([status])
  @@map("automation_run_steps")
}

// Per-day trading stats used for daily-loss and PDT guardrails.
model DailyStat {
  id                 Int      @id @default(autoincrement())
  userId             Int
  automationConfigId Int?
  date               DateTime @db.Date
startEquity      Float    @default(0)
  realizedPnl      Float    @default(0)
  unrealizedPnl    Float    @default(0)
  spentToday       Float    @default(0)
  tradeCount       Int      @default(0)
  dayTradeCount    Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  automationConfig AutomationConfig? @relation(fields: [automationConfigId], references: [id], onDelete: SetNull)

  @@unique([userId, automationConfigId, date])
  @@index([userId])
  @@index([date])
  @@map("daily_stats")
}
