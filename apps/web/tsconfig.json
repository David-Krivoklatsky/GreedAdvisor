{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@greed-advisor/db": ["../../packages/db"],
      "@greed-advisor/crypto": ["../../packages/crypto"],
      "@greed-advisor/auth": ["../../packages/auth"],
      "@greed-advisor/utils": ["../../packages/utils"],
      "@greed-advisor/validations": ["../../packages/validations"],
      "@greed-advisor/rate-limit": ["../../packages/rate-limit"],
      "@greed-advisor/middleware": ["../../packages/middleware"],
      "@greed-advisor/trading212": ["../../packages/trading212"],
      "@greed-advisor/alpaca": ["../../packages/alpaca"],
      "@greed-advisor/market-data": ["../../packages/market-data"],
      "@greed-advisor/trading": ["../../packages/trading"],
      "@greed-advisor/engine": ["../../packages/engine"],
      "@greed-advisor/ai": ["../../packages/ai"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
