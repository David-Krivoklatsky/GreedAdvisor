# ================================
# PRODUCTION Environment Variables for Vercel
# ================================

# --------------------------------
# Database Configuration (REQUIRED)
# --------------------------------
# PostgreSQL connection string from your database provider
# Examples:
# Neon: postgresql://[USER]:[PASSWORD]@[HOST]/[DB_NAME]?sslmode=require
# Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
# Railway: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway
DATABASE_URL="postgresql://username:password@hostname:port/database?sslmode=require"

# --------------------------------
# Security & Authentication (REQUIRED)
# --------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET="your-super-secure-jwt-secret-key-minimum-32-characters-required"
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="your-super-secure-nextauth-secret-minimum-32-characters"
# Your deployment URL
NEXTAUTH_URL="https://your-app-name.vercel.app"

# --------------------------------
# Application Configuration (REQUIRED)
# --------------------------------
# Your Vercel deployment URL
NEXT_PUBLIC_APP_URL="https://your-app-name.vercel.app"

# Production environment
NODE_ENV="production"

# --------------------------------
# Optional: Rate Limiting Configuration
# --------------------------------
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="900000"

# --------------------------------
# Encryption Key (REQUIRED - must be EXACTLY 32 chars)
# --------------------------------
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY="your-32-char-encryption-key"

# --------------------------------
# Engine webhook + notifications (for cron triggering)
# --------------------------------
# Shared secret guarding GET /api/engine/run?all=true (Vercel cron). Generate
# with: openssl rand -hex 32
ENGINE_WEBHOOK_SECRET="your-super-secure-engine-webhook-secret"
# Enable the standalone engine scheduler on a VPS (PM2). On Vercel the cron is
# the only trigger, so leave this disabled.
ENGINE_ENABLED="0"
ENGINE_TICK_MS="60000"
ENGINE_PAUSED="0"
# Optional Telegram bot token and generic notification webhook
TELEGRAM_BOT_TOKEN=""
NOTIFICATION_WEBHOOK_URL=""

# --------------------------------
# NOTE
# --------------------------------
# Trading212 (api key + api secret, demo/live), AI provider, and Twelve Data
# API keys are stored per-user in the database and configured in the app UI,
# not in environment variables.
