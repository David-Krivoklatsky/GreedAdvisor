# Database
# Local dev with Docker Compose (port 5433, not 5432):
DATABASE_URL="postgresql://user:password@localhost:5433/greedadvisor"
# Neon (serverless Postgres):
# DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# JWT
JWT_SECRET="your-jwt-secret-here-min-32-chars"

# Node Environment
NODE_ENV="development"

# API Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="900000"

# Encryption (must be EXACTLY 32 chars)
ENCRYPTION_KEY="your-32-character-encryption-key"
# Rotation: set the NEW key here, run `npm run db:rotate-keys` (re-encrypts all
# stored API keys), then update ENCRYPTION_KEY and remove NEW_ENCRYPTION_KEY.
# NEW_ENCRYPTION_KEY=""

# Vercel/CI: store ENCRYPTION_KEY, JWT_SECRET and DATABASE_URL as **Secrets**
# (encrypted), NOT plain Environment Variables — plain vars are visible in the
# dashboard and unencrypted build logs. Rotating JWT_SECRET signs everyone out.

# Autonomous trading engine (packages/engine)
# Set ENGINE_ENABLED=1 to let the scheduler run. ENGINE_PAUSED=1 is a hard stop.
ENGINE_ENABLED="0"
ENGINE_PAUSED="0"
# Heartbeat interval in ms between scheduler ticks (default 60000)
ENGINE_TICK_MS="60000"
# Shared secret for POST /api/engine/run (Vercel cron / cron-job.org / GH Actions)
ENGINE_WEBHOOK_SECRET=""
# Optional Telegram bot token for signal/order/loss notifications
TELEGRAM_BOT_TOKEN=""
# Optional generic webhook URL — the engine POSTs {type,title,body,payload,timestamp}
# JSON to it for every notification (wire up email/Slack/other).
NOTIFICATION_WEBHOOK_URL=""

# OAuth2 (Google + GitHub sign-in). Optional - omit to disable.
# Create credentials:
#   Google:  https://console.cloud.google.com/apis/credentials
#   GitHub:  https://github.com/settings/developers
# Redirect URIs must be: <APP_URL>/api/auth/oauth/google/callback and .../github/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# NOTE: Trading212 (api key + api secret, demo/live), AI provider, and Twelve Data
# API keys are stored per-user in the database and configured in the app UI
# (Profile → API Keys). They do NOT go in .env.
