{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["DATABASE_URL", "JWT_SECRET", "ENCRYPTION_KEY", "RATE_LIMIT_MAX", "RATE_LIMIT_WINDOW", "NODE_ENV"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "type-check": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": true,
      "inputs": ["packages/db/prisma/schema.prisma", "packages/db/.env"],
      "env": ["DATABASE_URL", "JWT_SECRET", "ENCRYPTION_KEY", "RATE_LIMIT_MAX", "RATE_LIMIT_WINDOW", "NODE_ENV"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "JWT_SECRET", "ENCRYPTION_KEY"]
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:reset": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:encrypt-keys": {
      "cache": false,
      "env": ["DATABASE_URL", "ENCRYPTION_KEY", "NEW_ENCRYPTION_KEY"]
    },
    "db:rotate-keys": {
      "cache": false,
      "env": ["DATABASE_URL", "ENCRYPTION_KEY", "NEW_ENCRYPTION_KEY"]
    }
  }
}
